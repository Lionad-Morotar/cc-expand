    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-code",
    "context-window",
    "cli",
    "patch"
  ],
  "author": "Lionad Morotar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0"
  }
