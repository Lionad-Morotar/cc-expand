{
  "name": "cc-expand",
  "version": "0.3.0",
  "description": "Expand Claude Code's context window beyond 200k tokens",
  "bin": {
    "cc-expand": "dist/cli.js",
    "ccx": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:unit": "vitest run tests/cli",
    "test:e2e": "npm run build && vitest run tests/integration",
    "dev": "tsup --watch",
    "dev:website": "pnpm --filter @cc-expand/website dev",
    "build:website": "pnpm --filter @cc-expand/website generate",
    "watch:patterns": "tsx scripts/watch-patterns.ts",
    "prepublishOnly": "npm run build && vitest run"
  },
  "keywords": [
    "claude-code",
    "context-window",
    "cli",
    "patch"
  ],
  "author": "Lionad Morotar",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/tar": "^7.0.87",
    "ali-oss": "^6.23.0",
    "chokidar": "^5.0.0",
    "happy-dom": "^20.10.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "tar": "^7.5.16"
  }
}
