{
  "name": "cc-expand",
  "version": "0.1.0",
  "description": "Expand Claude Code's context window beyond 200k tokens",
  "bin": {
    "cc-expand": "./dist/cli.js",
    "ccx": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/data/patterns.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
